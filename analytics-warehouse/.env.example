# Copy to ".env" (never committed) for a run on your own computer, or enter the
# same names as secrets in your scheduler (Render / GitHub Actions).
# Placeholders only. Real values come from Supabase -> Connect -> Session pooler.
#
# Source = the existing ERP project, using the READ-ONLY etl_reader login.
#   format: postgresql://etl_reader.<source-project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
SOURCE_DATABASE_URL=replace_me
# Warehouse = supply-chain-analytics-warehouse, using the etl_loader login.
#   format: postgresql://etl_loader.<warehouse-project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
WAREHOUSE_DATABASE_URL=replace_me
# CRM = the Aiven PostgreSQL CRM database, using the READ-ONLY crm_etl_reader login.
# Optional: leave as replace_me (or empty) and the ETL loads the ERP only.
#   format: postgresql://crm_etl_reader:<password>@<aiven-host>:<port>/defaultdb?sslmode=require
# (The CRM web app has its own CRM_DATABASE_URL on Vercel with a different login,
# crm_app. Never use that one here: the ETL must use crm_etl_reader.)
CRM_DATABASE_URL=replace_me
# Optional: Aiven's CA certificate (Aiven console -> service -> Overview -> CA certificate),
# pasted as PEM text. When set, the server certificate is fully verified.
CRM_DATABASE_CA=

ETL_BATCH_SIZE=1000
ETL_LOOKBACK_MINUTES=5
ETL_MAX_RETRIES=3
ETL_STATEMENT_TIMEOUT_SECONDS=45
# Refuse to mark more than this % of a table as deleted in one run (protects against
# an empty extract caused by a permissions problem).
ETL_MAX_DELETE_PERCENT=20
