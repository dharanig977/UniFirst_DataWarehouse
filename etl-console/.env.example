# Copy to .env.local for local development. Never commit real values.
# In Vercel, set the same names under Project -> Settings -> Environment Variables.

# Sign-in: the ERP's Supabase project (same accounts as the ERP and CRM apps).
# Publishable key only. The app refuses a secret / service-role key.
VITE_SUPABASE_URL=https://<erp-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace_me

# Server only (never sent to the browser): the WAREHOUSE project, read-only
# etl_console_reader login, Session pooler on port 5432.
#   postgresql://etl_console_reader.<warehouse-project-ref>:<password>@<pooler-host>:5432/postgres
WAREHOUSE_CONSOLE_URL=replace_me
# Supabase's CA certificate for the warehouse (Database settings -> SSL Configuration
# -> Download certificate), pasted as PEM text. Required: the connection is fully verified.
WAREHOUSE_DATABASE_CA=
